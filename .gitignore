# =========================
# Trading Bot - .gitignore
# =========================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/

# ---- Virtual Environments ----
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ---- Environment & Secrets ----
.env
.env.*
*.env
config.ini
secrets.json
secrets.yaml
secrets.yml
api_keys.txt
credentials.json
*.pem
*.key
*.p12

# ---- Trading Bot Specific ----
# Logs
logs/
*.log
trading_log*.txt
bot_log*.txt

# Data files
data/
*.csv
*.parquet
*.feather
*.h5
*.hdf5

# Model & cache files
models/
cache/
*.pkl
*.pickle
*.joblib

# Backtesting results
backtest_results/
results/
reports/

# ---- Jupyter Notebooks ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- Node.js (if applicable) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- IDEs & Editors ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ---- OS Generated ----
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ---- Database ----
*.db
*.sqlite
*.sqlite3

# ---- Testing ----
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.tox/
nosetests.xml
test-results/

# ---- Temporary Files ----
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ---- Compiled / Distributed ----
*.com
*.class
*.dll
*.exe
*.o
*.out
